# AthenaPK - 4D modes Harris controlled-limit input deck

<job>
problem_id = harris_4d

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 32
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 16
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 16
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.1
nlim = 1000

<hydro>
fluid = glmmhd
eos = adiabatic
riemann = hlle
reconstruction = plm
gamma = 1.666666666666667

<modes4d>
enabled = true
n_modes = 1
n_quadrature = 3
lambda = 1.0
em_conservative_transport = false
em_mu0 = 1.0
em_damping = 0.0
em_source_mass_gain = 1.0
em_source_current_gain = 1.0
em_source_damping_gain = 1.0
em_source_timelike_gain = 1.0
plasma_qom_ion = 1.0
plasma_qom_electron = -1.0
plasma_gamma = 1.666666666666667
plasma_force_source_gain = 1.0
plasma_momw_source_gain = 1.0
plasma_momw_pressure_source_gain = 1.0
plasma_w_flux_source_gain = 0.0
plasma_momw_damping = 0.1
plasma_rho_divj_gain = 1.0
plasma_energy_source_gain = 1.0
plasma_energy_floor = 0.0
plasma_pseudospectral_transport = false
plasma_pressure_transport_gain = 0.0
plasma_pressure_rusanov_gain = 1.0
plasma_pressure_signal_speed_cap = 10.0
plasma_pressure_flux_relative_cap = 50.0
plasma_pressure_transport_max_mode = 0
plasma_pressure_floor = 0.0

<problem/harris_4d>
perturbation_amp = 1.0e-3
sheet_half_width = 0.1
drift_current_scale = 0.0

<parthenon/output0>
file_type = hdf5
dt = -0.05
variables = cons,em4d_a,em4d_pi,plasma4d_cons

<parthenon/output1>
file_type = hst
dt = 0.01
