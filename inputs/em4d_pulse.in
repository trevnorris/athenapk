# AthenaPK - EM-only 4d modes pulse bring-up input

<job>
problem_id = em4d_pulse

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 64
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 16
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 16
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.2
nlim = 2000

<hydro>
fluid = glmmhd
eos = adiabatic
riemann = hlle
reconstruction = plm
gamma = 1.666666666666667

<modes4d>
enabled = true
n_modes = 4
n_quadrature = 6
lambda = 1.0
em_c_wave = 1.0
em_damping = 0.0

<problem/em4d_pulse>
rho0 = 1.0
p0 = 1.0
amplitude = 1.0e-3
sigma = 0.08
x0 = 0.0

<parthenon/output0>
file_type = hst
dt = 0.01

<parthenon/output1>
file_type = hdf5
dt = -0.05
variables = cons,em4d_a,em4d_pi
